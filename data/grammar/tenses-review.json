  "sections": [
    {
      "id": "present-perfect-simple",
      "title": "Present perfect simple",
      "title_es": "Pretérito perfecto: experiencias",
      "use": "Para hablar de **experiencias** en tu vida sin decir cuándo ocurrieron. En preguntas se usa mucho *ever* (alguna vez) y en respuestas *never* (nunca).",
      "forms": [
        {
          "label": "Afirmativa",
          "pattern": "sujeto + have / has + participio",
          "example": "I have eaten tripe."
        },
        {
          "label": "Negativa",
          "pattern": "sujeto + haven't / hasn't + participio",
          "example": "I have never eaten tripe."
        },
        {
          "label": "Pregunta",
          "pattern": "Have / Has + sujeto + participio?",
          "example": "Have you ever eaten tripe?"
        }
      ],
      "keywords": [
        "ever",
        "never",
        "already",
        "yet",
        "just"
      ],
      "examples": [
        {
          "en": "Have you ever eaten tripe?",
          "es": "¿Has comido callos alguna vez?"
        },
        {
          "en": "No, I have never eaten tripe.",
          "es": "No, nunca he comido callos."
        },
        {
          "en": "She has been to London twice.",
          "es": "Ha estado en Londres dos veces."
        }
      ],
      "mistakes": [
        {
          "wrong": "I have eaten tripe yesterday.",
          "right": "I ate tripe yesterday.",
          "why": "Si dices **cuándo** (*yesterday, last week, in 2020*), usa el past simple."
        }
      ],
