            ],
            [
              "Pasado = participio",
              "keep, sleep, feel, mean, leave, meet",
              "vocal corta + *t*: *kept, slept, felt, meant, left*"
            ],
            [
              "i – a – u",
              "begin, drink, ring, sing, swim",
              "*sing – sang – sung*"
            ],
            [
              "Participio en *-en*",
              "break, choose, eat, fall, forget, give, speak, steal, take, wake, write",
              "*broken, chosen, eaten…*"
            ],
            [
              "Participio en *-own*",
              "fly, grow, know, throw, draw",
              "*flown, grown, known, thrown, drawn*"
            ],
            [
