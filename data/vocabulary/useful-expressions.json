  "sections": [
    {
      "id": "idioms",
      "title": "Food idioms",
      "title_es": "Modismos con comida",
      "items": [
        {
          "en": "It's a piece of cake.",
          "ipa": "ɪts ə ˌpiːs əv ˈkeɪk",
          "pron": "its a piis av KÉIK",
          "es": "Es pan comido, es facilísimo.",
          "icon": "shortcake",
          "source": "cuaderno"
        },
        {
          "en": "easy peasy",
          "ipa": "ˌiː.zi ˈpiː.zi",
          "pron": "iizzi PÍIzzi",
          "es": "chupado, facilísimo",
          "icon": "thumbs-up",
          "note": "Muy informal.",
          "source": "cuaderno"
        },
        {
          "en": "go bananas",
          "ipa": "ˌɡəʊ bəˈnɑː.nəz",
          "pron": "gou baNÁAnazz",
          "es": "volverse loco, ponerse como loco",
          "icon": "banana",
          "example": "My dad went bananas when he saw the bill.",
          "example_es": "Mi padre se puso como loco al ver la cuenta.",
          "source": "cuaderno"
        }
      ]
    },
    {
      "id": "everyday",
      "title": "Everyday phrases",
      "title_es": "Frases del día a día",
      "items": [
        {
          "en": "It's up to you.",
          "ipa": "ɪts ˌʌp tə ˈjuː",
          "pron": "its ap ta YÚU",
          "es": "Como tú quieras, tú decides.",
          "icon": "person-shrugging",
          "source": "cuaderno"
        },
        {
          "en": "I don't mind.",
          "ipa": "aɪ ˌdəʊnt ˈmaɪnd",
          "pron": "ai dount MÁIND",
          "es": "No me importa, me da igual.",
          "icon": "open-hands",
          "source": "cuaderno"
        },
        {
          "en": "I can't stand…",
          "ipa": "aɪ ˌkɑːnt ˈstænd",
          "pron": "ai kaant STAND",
          "es": "No soporto…",
          "icon": "face-with-rolling-eyes",
          "note": "Va seguido de un nombre o de *-ing*.",
          "example": "I really can't stand cooking.",
          "example_es": "No soporto cocinar.",
          "source": "cuaderno"
        },
        {
          "en": "Hold on.",
          "ipa": "ˌhəʊld ˈɒn",
          "pron": "jould ON",
          "es": "Espera, un momento.",
          "icon": "raised-hand",
          "source": "cuaderno"
        },
        {
          "en": "So far so good.",
          "ipa": "ˌsəʊ ˈfɑː ˌsəʊ ˈɡʊd",
          "pron": "sou faa sou GUD",
          "es": "Por ahora, bien.",
          "icon": "thumbs-up",
          "source": "cuaderno"
        },
        {
          "en": "Nice to meet you. — You too.",
          "ipa": "ˌnaɪs tə ˈmiːt juː — ˈjuː tuː",
          "pron": "nais ta MÍIT yu — YU tuu",
          "es": "Encantado/a. — Igualmente.",
          "icon": "handshake",
          "source": "cuaderno"
        },
        {
          "en": "I'm 19 (years old).",
          "ipa": "aɪm ˌnaɪnˈtiːn",
          "pron": "aim nainTÍIN",
          "es": "Tengo 19 años.",
          "icon": "birthday-cake",
          "note": "¡Nunca *I have 19 years*! La edad va con *be*.",
          "source": "cuaderno"
        }
      ]
    }
  ]
}
