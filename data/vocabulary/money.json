          "ipa": "ɡʊd ˌvæl.juː fə ˈmʌn.i",
          "pron": "gud váliu fa MÁni",
          "es": "buena relación calidad-precio",
          "icon": "balance-scale",
          "example": "The menu of the day is good value for money.",
          "example_es": "El menú del día tiene buena relación calidad-precio."
        },
        {
          "en": "It costs an arm and a leg.",
          "ipa": "ɪt ˌkɒsts ən ˌɑːm ənd ə ˈleɡ",
          "pron": "it kosts an aam and a LEG",
          "es": "Cuesta un ojo de la cara.",
          "icon": "mechanical-leg",
          "note": "Muy informal."
        },
        {
          "en": "broke",
          "ipa": "brəʊk",
          "pron": "brouk",
          "es": "sin blanca, sin dinero",
          "icon": "face-with-hand-over-mouth",
          "note": "Informal: *I'm broke until payday*."
        },
        {
          "en": "wealthy / rich",
          "ipa": "ˈwel.θi / rɪtʃ",
          "pron": "UÉLzi / rich",
          "es": "adinerado / rico",
          "icon": "crown",
          "note": "*wealthy* es algo más formal."
        },
        {
          "en": "price",
          "ipa": "praɪs",
          "pron": "práis",
          "es": "precio",
          "icon": "label",
          "note": "*How much is it?* / *What's the price?*"
        },
        {
          "en": "discount",
          "ipa": "ˈdɪs.kaʊnt",
          "pron": "DÍSkaunt",
          "es": "descuento",
          "icon": "shopping-cart",
          "note": "*Is there a student discount?*"
        },
        {
          "en": "refund",
          "ipa": "ˈriː.fʌnd",
          "pron": "RÍIfand",
          "es": "reembolso, devolución del dinero",
          "icon": "counterclockwise-arrows-button",
          "note": "*Can I get a refund?* = ¿Me pueden devolver el dinero?"
        }
      ]
    }
  ]
}
